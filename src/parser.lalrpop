use crate::error::Error;
use crate::ir;
use crate::lexer::Token;
use crate::value::Value;

grammar;

extern {

    type Location = usize;
    type Error = Error;

    enum Token {
        // symbols
        "*"         => Token::Ast,
        ","         => Token::Comma,
        ":"         => Token::Colon,
        "$"         => Token::Dollar,
        ".."        => Token::DotDot,
        "..."       => Token::Ellipsis,
        "="         => Token::Eq,
        ">"         => Token::Gt,
        ">="        => Token::Ge,
        "<"         => Token::Lt,
        "<="        => Token::Le,
        "-"         => Token::Minus,
        "!="        => Token::Ne,
        "%"         => Token::Percent,
        "."         => Token::Period,
        "|"         => Token::Pipe,
        "+"         => Token::Plus,
        ";"         => Token::SemiColon,
        "/"         => Token::Sol,
        "("         => Token::ParenL,
        ")"         => Token::ParenR,
        "{"         => Token::BraceL,
        "}"         => Token::BraceR,
        "["         => Token::BracketL,
        "]"         => Token::BracketR,
        // keywords
        "as"        => Token::As,
        "create"    => Token::Create,
        "delete"    => Token::Delete,
        "drop"      => Token::Drop,
        "limit"     => Token::Limit,
        "from"      => Token::From,
        "insert"    => Token::Insert,
        "into"      => Token::Into,
        "select"    => Token::Select,
        "table"     => Token::Table,
        "where"     => Token::Where,
        // types
        "t_bool"    => Token::TypeBool,
        "t_int"     => Token::TypeInt,
        "t_float"   => Token::TypeFloat,
        "t_number"  => Token::TypeNumber,
        "t_string"  => Token::TypeString,
        "t_object"  => Token::TypeObject,
        "t_array"   => Token::TypeArray,
        "t_any"     => Token::TypeAny,
        // literals
        "null"      => Token::Null,
        "true"      => Token::True,
        "false"     => Token::False,
        "number"    => Token::Number(<f64>),
        "string"    => Token::String(<String>),
        // names and identifiers
        "ident"     => Token::Identifier(<String>),
    }
}

pub Rql = <Statement> ";";

//------------------------------
// STATEMENTS
//------------------------------

Statement: ir::Statement = {
    Create  => ir::Statement::Create(<>),
    Delete  => ir::Statement::Delete(<>),
    Drop    => ir::Statement::Drop(<>),
    Insert  => ir::Statement::Insert(<>),
    Select  => ir::Statement::Select(<>),
};

// CREATE STATEMENT
//------------------------------

Create: ir::Create = CreateTable;

CreateTable: ir::Create = "create" "table" <TableDefinition> => ir::Create::Table(<>);

TableDefinition: ir::Table = {
    <name:TableName>                                    => ir::table_definition(name, vec![]),
    <name:TableName> "(" <cols:ColumnDefinitions> ")"   => ir::table_definition(name, cols),
};

TableName: String = "ident";

ColumnDefinitions: Vec<ir::ColumnDefinition> = List<ColumnDefinition>;

ColumnDefinition: ir::ColumnDefinition = <name:"ident"> <typ:ColumnType> => ir::column_definition(name, typ);

ColumnType: ir::ColumnType = {
    "t_int"    => ir::ColumnType::Int,
    "t_string" => ir::ColumnType::String,
};

// SELECT STATEMENT
//------------------------------

Select: ir::Select = {
    "select" <SelectConstructor>                => todo!("select without block"),
    "select" <SelectConstructor> <SelectBlock>  => ir::select(<>),
};

SelectConstructor: ir::Constructor = {
    "."                => ir::Constructor::None,
    "*"                => ir::Constructor::Star,
    <Expr>             => ir::Constructor::Expr(<>),
    <List<SelectItem>> => ir::Constructor::List(<>),
};

// TODO clean up select item modeling when implementing the with clause.
SelectItem: ir::Member = <Expr> "as" <"ident"> => ir::select_item(<>);

SelectBlock: ir::Select =
    <From>
    <Where?>
    <Limit?> => ir::select_block(<>);

// TODO from <expr>
From: ir::Iter = {
    "from" <"ident">                    => ir::from_table(<>),
    "from" <FromSource> "as"? <"ident"> => ir::from_source(<>),
};

FromSource: ir::Source = {
    <"ident">                   => ir::from_source_table(<>),
    <"ident"> "$" <Segment+>    => ir::from_source_path(<>),
};

Where: ir::Where = "where" <Expr>;

Limit: ir::Limit = {
    "limit" <"number">                  => ir::limit_take(<>),
    "limit" <"number"> ".."             => ir::limit_skip(<>),
    "limit" <"number"> ".." <"number">  => ir::limit_slice(<>),
};

// INSERT STATEMENT
//------------------------------

Insert: ir::Insert = "insert" "into" <InsertTarget> "(" <InsertSource> ")" => ir::insert(<>);

InsertTarget: String = "ident";

InsertSource: Vec<ir::Expr> = List<Expr>;

// DELETE STATEMENT
//------------------------------

// TODO delete statement

Delete: String = "delete" "from" <"ident">;

// DROP STATEMENT
//------------------------------

// TODO drop statement

Drop: String = "drop" "table" <"ident">;

//------------------------------
// TYPES
//------------------------------

Type: ir::Type = {
    TAny,
    TScalar,
    TObject,
    TArray,
};

TAny: ir::Type = {
    "t_any" => ir::t_any(),
};

TScalar: ir::Type = {
    "t_bool"    => ir::t_bool(),
    "t_number"  => ir::t_number(),
    "t_string"  => ir::t_string(),
};

// TODO open object type
TObject: ir::Type = {
    "t_object"          => ir::t_object(vec![], true),
    "{" <TMembers> "}"  => ir::t_object(<>, false),
};

TMembers: Vec<ir::TMember> = List<TMember>;

// TODO remove nullability ??
TMember: ir::TMember = {
    <"ident"> ":" <Type>            => ir::t_member(<>, false),
    <"ident"> ":" <Type> "|" "null" => ir::t_member(<>, true),
};

TArray: ir::Type = {
    "t_array"   => ir::t_array(),
    "[" "]"     => ir::t_array(),
};

//------------------------------
// JSONPath
//------------------------------

Path: ir::Path = <"ident"> "$" <Segment+> => ir::path(<>);

Segment: ir::Segment = {
    "[" <Selectors> "]"         => ir::segment_child(<>),
    "." <"ident">               => ir::segment_child_name(<>),
    "." "*"                     => ir::segment_child_wildcard(),
    ".." "[" <Selectors> "]"    => ir::segment_descd(<>),
    ".." <"ident">              => ir::segment_descd_name(<>),
    ".." "*"                    => ir::segment_descd_wildcard(),
};

Selectors: Vec<ir::Selector> = List<Selector>;

Selector: ir::Selector = {
    "string"    => ir::selector_name(<>),
    "*"         => ir::selector_wildcard(),
    "number"    => ir::selector_index(<> as usize), // truncate f64 to usize
};

//------------------------------
// EXPRESSIONS
//------------------------------

Expr: ir::Expr = {

    #[precedence(level="0")]
    "ident"                         => ir::expr_var(<>),
    <"ident"> "(" <List<Expr>> ")"  => ir::expr_call(<>),
    Value                           => ir::expr_lit(<>),
    "{" <Members> "}"               => ir::expr_obj(<>),
    "(" <Expr> ")"                  => <>,

    #[precedence(level="1")]    #[assoc(side="left")]
    <Expr> "[" <Expr> "]"       => ir::expr_jpe(<>),
    <Expr> "." <"ident">        => ir::expr_jpk(<>),

    #[precedence(level="2")]    #[assoc(side="left")]
    <Expr> "*" <Expr>           => ir::expr_op("*", <>),
    <Expr> "/" <Expr>           => ir::expr_op("/", <>),
    <Expr> "%" <Expr>           => ir::expr_op("%", <>),

    #[precedence(level="3")]    #[assoc(side="left")]
    <Expr> "+" <Expr>           => ir::expr_op("+", <>),
    <Expr> "-" <Expr>           => ir::expr_op("-", <>),

    #[precedence(level="4")]    #[assoc(side="left")]
    <Expr> "<" <Expr>           => ir::expr_op("<", <>),
    <Expr> "<=" <Expr>          => ir::expr_op("<=", <>),
    <Expr> "=" <Expr>           => ir::expr_op("=", <>),
    <Expr> ">" <Expr>           => ir::expr_op(">", <>),
    <Expr> ">=" <Expr>          => ir::expr_op(">=", <>),
    <Expr> "!=" <Expr>          => ir::expr_op("!=", <>),
}

Value: Value = {
    "null"      => Value::null(),
    "true"      => Value::bool(true),
    "false"     => Value::bool(false),
    "number"    => Value::number(<>),
    "string"    => Value::string(<>),
};

//=== Objects

Members: Vec<ir::Member> = List<Member>;

// TODO replace var with ident and path alternatives.
Member: ir::Member = {
    // Var                     => ir::member_var(<>),
    //     "ident"                 => ir::expr_var(<>),
    //     <Expr> "." <"ident">    => ir::expr_jpk(<>),
    <"ident">  ":" <Expr>   => ir::member_assign(<>),
    <"string"> ":" <Expr>   => ir::member_assign(<>),
    "..." <Expr>            => ir::member_spread(<>),
}

//------------------------------
// MACROS
//------------------------------

List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
