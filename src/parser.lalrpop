// MonaDB grammar — the LALRPOP LR(1) parser.
//
// Rules stay thin: each action constructs an AST node via an `ast.rs` function.
// Tokens come from the external `lexer.rs`, declared in the `extern` block below.

use crate::ast;
use crate::error::Error;
use crate::lexer::Token;
use crate::value::Value;

// `param_pos` is a positional-parameter counter threaded so each `?` is
// numbered in source order (see `ast::expr_param_positional`).
grammar(param_pos: &std::cell::Cell<u32>);

extern {

    type Location = usize;
    type Error = Error;

    enum Token {
        // symbols
        "*"         => Token::Ast,
        ","         => Token::Comma,
        ":"         => Token::Colon,
        "?"         => Token::Question,
        ".."        => Token::DotDot,
        "..."       => Token::Ellipsis,
        "="         => Token::Eq,
        ">"         => Token::Gt,
        ">="        => Token::Ge,
        "<"         => Token::Lt,
        "<="        => Token::Le,
        "-"         => Token::Minus,
        "!="        => Token::Ne,
        "%"         => Token::Percent,
        "."         => Token::Period,
        "|"         => Token::Pipe,
        "+"         => Token::Plus,
        ";"         => Token::SemiColon,
        "/"         => Token::Sol,
        "("         => Token::ParenL,
        ")"         => Token::ParenR,
        "{"         => Token::BraceL,
        "}"         => Token::BraceR,
        "["         => Token::BracketL,
        "]"         => Token::BracketR,
        // keywords
        "all"       => Token::All,
        "and"       => Token::And,
        "as"        => Token::As,
        "asc"       => Token::Asc,
        "at"        => Token::At,
        "begin"     => Token::Begin,
        "between"   => Token::Between,
        "by"        => Token::By,
        "clear"     => Token::Clear,
        "commit"    => Token::Commit,
        "copy"      => Token::Copy,
        "create"    => Token::Create,
        "delete"    => Token::Delete,
        "desc"      => Token::Desc,
        "drop"      => Token::Drop,
        "exists"    => Token::Exists,
        "group"     => Token::Group,
        "having"    => Token::Having,
        "in"        => Token::In,
        "is"        => Token::Is,
        "limit"     => Token::Limit,
        "from"      => Token::From,
        "insert"    => Token::Insert,
        "into"      => Token::Into,
        "not"       => Token::Not,
        "or"        => Token::Or,
        "order"     => Token::Order,
        "pivot"     => Token::Pivot,
        "rollback"  => Token::Rollback,
        "select"    => Token::Select,
        "table"     => Token::Table,
        "to"        => Token::To,
        "unknown"   => Token::Unknown,
        "unpivot"   => Token::Unpivot,
        "where"     => Token::Where,
        // types
        "t_bool"    => Token::TypeBool,
        "t_int"     => Token::TypeInt,
        "t_float"   => Token::TypeFloat,
        "t_number"  => Token::TypeNumber,
        "t_string"  => Token::TypeString,
        "t_object"  => Token::TypeObject,
        "t_array"   => Token::TypeArray,
        "t_any"     => Token::TypeAny,
        // literals
        "null"      => Token::Null,
        "true"      => Token::True,
        "false"     => Token::False,
        "number"    => Token::Number(<String>),
        "string"    => Token::String(<String>),
        // query parameters
        "$num"      => Token::NumberedParam(<String>),
        "$name"     => Token::NamedParam(<String>),
        // names and identifiers
        "ident"     => Token::Identifier(<String>),
    }
}

pub Sql = <Statement> ";";

//------------------------------
// STATEMENTS
//------------------------------

Statement: ast::Statement = {
    "begin"    => ast::Statement::Begin,
    Clear      => ast::Statement::Clear(<>),
    "commit"   => ast::Statement::Commit,
    Copy       => ast::Statement::Copy(<>),
    Create     => ast::Statement::Create(<>),
    Delete     => ast::Statement::Delete(<>),
    Drop       => ast::Statement::Drop(<>),
    Insert     => ast::Statement::Insert(<>),
    "rollback" => ast::Statement::Rollback,
    Select     => ast::Statement::Select(<>),
};

// CREATE STATEMENT
//------------------------------

Create: ast::Create = {
    CreateTableAs,
    CreateTable,
};

CreateTableAs: ast::Create =
    "create" "table" <def:TableDefinition> "as" <query:Select> =>
        ast::create_table_as(def, query);

CreateTable: ast::Create = "create" "table" <TableDefinition> => ast::create_table(<>);

TableDefinition: ast::TableDefinition = {
    <name:TableName>                        => ast::table_definition(name, vec![]),
    <name:TableName> "(" <keys:Keys> ")"    => ast::table_definition(name, keys),
};

TableName: String = "ident";

Keys: Vec<ast::Key> = List<Key>;

Key: ast::Key = <name:"ident"> <ty:Type> => ast::table_key(name, ty);

// SELECT STATEMENT
//------------------------------

Select: ast::Select = {
    "select" <SelectConstructor>                => ast::select_value(<>),
    "select" <SelectConstructor> <SelectBlock>  => ast::select(<>),
    "pivot" <Expr> "at" <Expr> <SelectBlock>    => ast::pivot(<>),
};

SelectConstructor: ast::Constructor = {
    "."                => ast::Constructor::None,
    "*"                => ast::Constructor::Star,
    <Expr>             => ast::Constructor::Expr(<>),
    <List<SelectItem>> => ast::Constructor::List(<>),
};

// TODO clean up select item modeling when implementing the with clause.
SelectItem: ast::Member = <Expr> "as" <"ident"> => ast::select_item(<>);

SelectBlock: ast::Select =
    <From>
    <Where?>
    <GroupBy?>
    <Having?>
    <OrderBy?>
    <Limit?> => ast::select_block(<>);

From: Vec<ast::From> = "from" <List<FromItem>>;

GroupBy: ast::GroupBy = "group" "by" <List<Expr>> => ast::group_by(<>);

OrderBy: ast::OrderBy = "order" "by" <List<OrderItem>> => ast::order_by(<>);

OrderItem: ast::OrderKey = <Expr> <OrderDir?> => ast::order_key(<>);

OrderDir: bool = {
    "asc"   => false,
    "desc"  => true,
};

FromItem: ast::From = {
    <Expr> <("as"? <"ident">)?>                              => ast::from_item(<>),
    "unpivot" <Expr> <("as"? <"ident">)?> <("at" <"ident">)?> => ast::unpivot_item(<>),
};

Where: ast::Where = "where" <Expr>;

Having: ast::Where = "having" <Expr>;

Limit: ast::Limit = {
    "limit" <n:"number">                       => ast::limit_take(n.parse().unwrap_or(0)),
    "limit" <n:"number"> ".."                  => ast::limit_skip(n.parse().unwrap_or(0)),
    "limit" <a:"number"> ".." <b:"number">     => ast::limit_slice(a.parse().unwrap_or(0), b.parse().unwrap_or(0)),
};

// INSERT STATEMENT
//------------------------------

Insert: ast::Insert = "insert" "into" <InsertTarget> "(" <InsertSource> ")" => ast::insert(<>);

InsertTarget: String = "ident";

InsertSource: Vec<ast::Expr> = List<Expr>;

// DELETE STATEMENT
//------------------------------

Delete: ast::Delete =
    "delete" "from" <"ident"> <("as"? <"ident">)?> <Where?> => ast::delete(<>);

// DROP STATEMENT
//------------------------------

Drop: ast::Drop = "drop" "table" <"ident"> => ast::drop_table(<>);

// CLEAR STATEMENT
//------------------------------

Clear: ast::Clear = "clear" "table" <"ident"> => ast::clear_table(<>);

// COPY STATEMENT
//------------------------------

Copy: ast::Copy = {
    "copy" <target:TableDefinition> "from" <path:"string"> <opts:CopyOptions> =>
        ast::copy_from(target, path, opts),
    "copy" <source:CopySource> "to" <path:"string"> <opts:CopyOptions> =>
        ast::copy_to(source, path, opts),
};

CopySource: ast::CopySource = {
    <name:TableName> => ast::copy_source_table(name),
    "(" <Select> ")" => ast::copy_source_query(<>),
};

CopyOptions: ast::Obj = {
    => vec![],
    "{" <Members> "}" => <>,
};

//------------------------------
// TYPES
//------------------------------

Type: ast::Type = {
    TAny,
    TScalar,
    TObject,
    TArray,
};

TAny: ast::Type = {
    "t_any" => ast::t_any(),
};

TScalar: ast::Type = {
    "t_bool"    => ast::t_bool(),
    "t_int"     => ast::t_int(),
    "t_float"   => ast::t_float(),
    "t_number"  => ast::t_number(),
    "t_string"  => ast::t_string(),
};

TObject: ast::Type = {
    "t_object"          => ast::t_object(vec![]),
    "{" <TMembers> "}"  => ast::t_object(<>),
};

TMembers: Vec<ast::TMember> = List<TMember>;

TMember: ast::TMember = <"ident"> ":" <Type> => ast::t_member(<>);

TArray: ast::Type = {
    "t_array"   => ast::t_array(),
    "[" "]"     => ast::t_array(),
};

//------------------------------
// EXPRESSIONS
//------------------------------

Atom: ast::Expr = {
    "ident"                         => ast::expr_var(<>),
    <"ident"> "(" <List<Expr>> ")"  => ast::expr_call(<>),
    <"ident"> "(" "*" ")"           => ast::expr_call_star(<>),
    <t:TScalar> "(" <e:Expr> ")"    => ast::expr_cast(e, &t),
    Value                           => ast::expr_lit(<>),
    "?"                             => ast::expr_param_positional(param_pos),
    "$num"                          => ast::expr_param_numbered(<>),
    "$name"                         => ast::expr_param_named(<>),
    "{" <Members> "}"               => ast::expr_obj(<>),
    "[" <List<Expr>> "]"            => ast::expr_array(<>),
    "(" <Expr> ")"                  => <>,
    "(" <Select> ")"                => ast::expr_subquery(<>),
    "exists" "(" <Select> ")"       => ast::expr_exists(<>),
};

Expr: ast::Expr = {
    #[precedence(level="0")]
    Atom                        => <>,

    #[precedence(level="1")]    #[assoc(side="left")]
    <Expr> "[" <Expr> "]"                               => ast::expr_jpe(<>),
    <base:Expr> "[" <first:Expr> "," <rest:List<Expr>> "]" => ast::expr_subscript(base, first, rest),
    <Expr> "." <"ident">                                => ast::expr_jpk(<>),

    #[precedence(level="2")]    #[assoc(side="left")]
    <Expr> "*" <Expr>           => ast::expr_binary("*", <>),
    <Expr> "/" <Expr>           => ast::expr_binary("/", <>),
    <Expr> "%" <Expr>           => ast::expr_binary("%", <>),

    #[precedence(level="3")]    #[assoc(side="left")]
    <Expr> "+" <Expr>           => ast::expr_binary("+", <>),
    <Expr> "-" <Expr>           => ast::expr_binary("-", <>),

    #[precedence(level="4")]    #[assoc(side="left")]
    <Expr> "<" <Expr>           => ast::expr_binary("<", <>),
    <Expr> "<=" <Expr>          => ast::expr_binary("<=", <>),
    <Expr> "=" <Expr>           => ast::expr_binary("=", <>),
    <Expr> ">" <Expr>           => ast::expr_binary(">", <>),
    <Expr> ">=" <Expr>          => ast::expr_binary(">=", <>),
    <Expr> "!=" <Expr>          => ast::expr_binary("!=", <>),
    // Quantified comparisons `lhs <op> any/all (select ...)`. The `any`/`all`
    // tail can't begin an ordinary expression, so LR(1) picks these apart from
    // the binary rules above by a single lookahead token after the operator.
    <l:Expr> "<"  <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Lt, r.0, r.1),
    <l:Expr> "<=" <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Le, r.0, r.1),
    <l:Expr> "="  <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Eq, r.0, r.1),
    <l:Expr> ">"  <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Gt, r.0, r.1),
    <l:Expr> ">=" <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Ge, r.0, r.1),
    <l:Expr> "!=" <r:QuantRhs>  => ast::expr_quantify(l, ast::CmpOp::Ne, r.0, r.1),

    #[precedence(level="5")]                    #[assoc(side="left")]
    <Expr> "is" "null"                          => ast::expr_is_null(<>),
    <Expr> "is" "not" "null"                    => ast::expr_is_not_null(<>),
    <Expr> "is" "true"                          => ast::expr_is_true(<>),
    <Expr> "is" "false"                         => ast::expr_is_false(<>),
    <Expr> "is" "unknown"                       => ast::expr_is_unknown(<>),
    <Expr> "is" "not" "true"                    => ast::expr_is_not_true(<>),
    <Expr> "is" "not" "false"                   => ast::expr_is_not_false(<>),
    <Expr> "is" "not" "unknown"                 => ast::expr_is_not_unknown(<>),
    <Expr> "between" <Expr> "and" <Expr>        => ast::expr_between(<>),
    <Expr> "not" "between" <Expr> "and" <Expr>  => ast::expr_not_between(<>),
    <Expr> "in" "(" <List<Expr>> ")"            => ast::expr_in_list(<>),
    <Expr> "not" "in" "(" <List<Expr>> ")"      => ast::expr_not_in_list(<>),
    <Expr> "in" "(" <Select> ")"                => ast::expr_in_subquery(<>),
    <Expr> "not" "in" "(" <Select> ")"          => ast::expr_not_in_subquery(<>),

    #[precedence(level="6")]
    "not" <Expr>                => ast::expr_not(<>),

    #[precedence(level="7")]    #[assoc(side="left")]
    <Expr> "and" <Expr>         => ast::expr_binary("and", <>),

    #[precedence(level="8")]    #[assoc(side="left")]
    <Expr> "or" <Expr>          => ast::expr_binary("or", <>),
}

// The right-hand side of a quantified comparison: the quantifier (`any` reuses
// the `t_any` type token; `all` returns `true`) and the subquery it ranges over.
QuantRhs: (bool, ast::Select) = {
    "t_any" "(" <Select> ")"    => (false, <>),
    "all"   "(" <Select> ")"    => (true, <>),
};

Value: Value = {
    "null"      => Value::null(),
    "true"      => Value::bool(true),
    "false"     => Value::bool(false),
    <n:"number"> => Value::number(&n),
    "string"    => Value::string(<>),
};

//=== Objects

Members: Vec<ast::Member> = List<Member>;

Member: ast::Member = {
    <"string"> ":" <Expr>   => ast::member_assign(<>),
    "..." <Expr>            => ast::member_spread(<>),
}

//------------------------------
// MACROS
//------------------------------

List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
