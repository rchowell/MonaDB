// MonaDB grammar — the LALRPOP LR(1) parser.
//
// Rules stay thin: each action constructs an IR node via an `ir.rs` function.
// Tokens come from the external `lexer.rs`, declared in the `extern` block below.

use crate::error::Error;
use crate::ir;
use crate::lexer::Token;
use crate::value::Value;

// `param_pos` is a positional-parameter counter threaded so each `?` is
// numbered in source order (see `ir::expr_param_positional`).
grammar(param_pos: &std::cell::Cell<u32>);

extern {

    type Location = usize;
    type Error = Error;

    enum Token {
        // symbols
        "*"         => Token::Ast,
        ","         => Token::Comma,
        ":"         => Token::Colon,
        "$"         => Token::Dollar,
        "?"         => Token::Question,
        ".."        => Token::DotDot,
        "..."       => Token::Ellipsis,
        "="         => Token::Eq,
        ">"         => Token::Gt,
        ">="        => Token::Ge,
        "<"         => Token::Lt,
        "<="        => Token::Le,
        "-"         => Token::Minus,
        "!="        => Token::Ne,
        "%"         => Token::Percent,
        "."         => Token::Period,
        "|"         => Token::Pipe,
        "+"         => Token::Plus,
        ";"         => Token::SemiColon,
        "/"         => Token::Sol,
        "("         => Token::ParenL,
        ")"         => Token::ParenR,
        "{"         => Token::BraceL,
        "}"         => Token::BraceR,
        "["         => Token::BracketL,
        "]"         => Token::BracketR,
        // keywords
        "all"       => Token::All,
        "and"       => Token::And,
        "as"        => Token::As,
        "asc"       => Token::Asc,
        "at"        => Token::At,
        "begin"     => Token::Begin,
        "between"   => Token::Between,
        "by"        => Token::By,
        "clear"     => Token::Clear,
        "commit"    => Token::Commit,
        "copy"      => Token::Copy,
        "create"    => Token::Create,
        "delete"    => Token::Delete,
        "desc"      => Token::Desc,
        "drop"      => Token::Drop,
        "exists"    => Token::Exists,
        "group"     => Token::Group,
        "having"    => Token::Having,
        "in"        => Token::In,
        "is"        => Token::Is,
        "limit"     => Token::Limit,
        "from"      => Token::From,
        "insert"    => Token::Insert,
        "into"      => Token::Into,
        "not"       => Token::Not,
        "or"        => Token::Or,
        "order"     => Token::Order,
        "pivot"     => Token::Pivot,
        "rollback"  => Token::Rollback,
        "select"    => Token::Select,
        "table"     => Token::Table,
        "to"        => Token::To,
        "unknown"   => Token::Unknown,
        "unpivot"   => Token::Unpivot,
        "where"     => Token::Where,
        // types
        "t_bool"    => Token::TypeBool,
        "t_int"     => Token::TypeInt,
        "t_float"   => Token::TypeFloat,
        "t_number"  => Token::TypeNumber,
        "t_string"  => Token::TypeString,
        "t_object"  => Token::TypeObject,
        "t_array"   => Token::TypeArray,
        "t_any"     => Token::TypeAny,
        // literals
        "null"      => Token::Null,
        "true"      => Token::True,
        "false"     => Token::False,
        "number"    => Token::Number(<String>),
        "string"    => Token::String(<String>),
        // query parameters
        "$num"      => Token::NumberedParam(<String>),
        "$name"     => Token::NamedParam(<String>),
        // names and identifiers
        "ident"     => Token::Identifier(<String>),
    }
}

pub Sql = <Statement> ";";

//------------------------------
// STATEMENTS
//------------------------------

Statement: ir::Statement = {
    "begin"    => ir::Statement::Begin,
    Clear      => ir::Statement::Clear(<>),
    "commit"   => ir::Statement::Commit,
    Copy       => ir::Statement::Copy(<>),
    Create     => ir::Statement::Create(<>),
    Delete     => ir::Statement::Delete(<>),
    Drop       => ir::Statement::Drop(<>),
    Insert     => ir::Statement::Insert(<>),
    "rollback" => ir::Statement::Rollback,
    Select     => ir::Statement::Select(<>),
};

// CREATE STATEMENT
//------------------------------

Create: ir::Create = {
    CreateTableAs,
    CreateTable,
};

CreateTableAs: ir::Create =
    "create" "table" <def:TableDefinition> "as" <query:Select> =>
        ir::create_table_as(def, query);

CreateTable: ir::Create = "create" "table" <TableDefinition> => ir::create_table(<>);

TableDefinition: ir::TableDefinition = {
    <name:TableName>                        => ir::table_definition(name, vec![]),
    <name:TableName> "(" <keys:Keys> ")"    => ir::table_definition(name, keys),
};

TableName: String = "ident";

Keys: Vec<ir::Key> = List<Key>;

Key: ir::Key = <name:"ident"> <ty:Type> => ir::table_key(name, ty);

// SELECT STATEMENT
//------------------------------

Select: ir::Select = {
    "select" <SelectConstructor>                => ir::select_value(<>),
    "select" <SelectConstructor> <SelectBlock>  => ir::select(<>),
    "pivot" <Expr> "at" <Expr> <SelectBlock>    => ir::pivot(<>),
};

SelectConstructor: ir::Constructor = {
    "."                => ir::Constructor::None,
    "*"                => ir::Constructor::Star,
    <Expr>             => ir::Constructor::Expr(<>),
    <List<SelectItem>> => ir::Constructor::List(<>),
};

// TODO clean up select item modeling when implementing the with clause.
SelectItem: ir::Member = <Expr> "as" <"ident"> => ir::select_item(<>);

SelectBlock: ir::Select =
    <From>
    <Where?>
    <GroupBy?>
    <Having?>
    <OrderBy?>
    <Limit?> => ir::select_block(<>);

From: Vec<ir::From> = "from" <List<FromItem>>;

GroupBy: ir::GroupBy = "group" "by" <List<Expr>> => ir::group_by(<>);

OrderBy: ir::OrderBy = "order" "by" <List<OrderItem>> => ir::order_by(<>);

OrderItem: ir::OrderKey = <Expr> <OrderDir?> => ir::order_key(<>);

OrderDir: bool = {
    "asc"   => false,
    "desc"  => true,
};

FromItem: ir::From = {
    <Expr> <("as"? <"ident">)?>                              => ir::from_item(<>),
    "unpivot" <Expr> <("as"? <"ident">)?> <("at" <"ident">)?> => ir::unpivot_item(<>),
};

Where: ir::Where = "where" <Expr>;

Having: ir::Where = "having" <Expr>;

Limit: ir::Limit = {
    "limit" <n:"number">                       => ir::limit_take(n.parse().unwrap_or(0)),
    "limit" <n:"number"> ".."                  => ir::limit_skip(n.parse().unwrap_or(0)),
    "limit" <a:"number"> ".." <b:"number">     => ir::limit_slice(a.parse().unwrap_or(0), b.parse().unwrap_or(0)),
};

// INSERT STATEMENT
//------------------------------

Insert: ir::Insert = "insert" "into" <InsertTarget> "(" <InsertSource> ")" => ir::insert(<>);

InsertTarget: String = "ident";

InsertSource: Vec<ir::Expr> = List<Expr>;

// DELETE STATEMENT
//------------------------------

Delete: ir::Delete =
    "delete" "from" <"ident"> <("as"? <"ident">)?> <Where?> => ir::delete(<>);

// DROP STATEMENT
//------------------------------

Drop: ir::Drop = "drop" "table" <"ident"> => ir::drop_table(<>);

// CLEAR STATEMENT
//------------------------------

Clear: ir::Clear = "clear" "table" <"ident"> => ir::clear_table(<>);

// COPY STATEMENT
//------------------------------

Copy: ir::Copy = {
    "copy" <target:TableDefinition> "from" <path:"string"> <opts:CopyOptions> =>
        ir::copy_from(target, path, opts),
    "copy" <source:CopySource> "to" <path:"string"> <opts:CopyOptions> =>
        ir::copy_to(source, path, opts),
};

CopySource: ir::CopySource = {
    <name:TableName> => ir::copy_source_table(name),
    "(" <Select> ")" => ir::copy_source_query(<>),
};

CopyOptions: ir::Obj = {
    => vec![],
    "{" <Members> "}" => <>,
};

//------------------------------
// TYPES
//------------------------------

Type: ir::Type = {
    TAny,
    TScalar,
    TObject,
    TArray,
};

TAny: ir::Type = {
    "t_any" => ir::t_any(),
};

TScalar: ir::Type = {
    "t_bool"    => ir::t_bool(),
    "t_int"     => ir::t_int(),
    "t_float"   => ir::t_float(),
    "t_number"  => ir::t_number(),
    "t_string"  => ir::t_string(),
};

TObject: ir::Type = {
    "t_object"          => ir::t_object(vec![]),
    "{" <TMembers> "}"  => ir::t_object(<>),
};

TMembers: Vec<ir::TMember> = List<TMember>;

TMember: ir::TMember = <"ident"> ":" <Type> => ir::t_member(<>);

TArray: ir::Type = {
    "t_array"   => ir::t_array(),
    "[" "]"     => ir::t_array(),
};

//------------------------------
// JSONPath
//------------------------------

Path: ir::Path = <"ident"> "$" <Segment+> => ir::path(<>);

Segment: ir::Segment = {
    "[" <Selectors> "]"         => ir::segment_child(<>),
    "." <"ident">               => ir::segment_child_name(<>),
    "." "*"                     => ir::segment_child_wildcard(),
    ".." "[" <Selectors> "]"    => ir::segment_descd(<>),
    ".." <"ident">              => ir::segment_descd_name(<>),
    ".." "*"                    => ir::segment_descd_wildcard(),
};

Selectors: Vec<ir::Selector> = List<Selector>;

Selector: ir::Selector = {
    "string"        => ir::selector_name(<>),
    "*"             => ir::selector_wildcard(),
    <n:"number">    => ir::selector_index(n.parse::<usize>().unwrap_or(0)),
};

//------------------------------
// EXPRESSIONS
//------------------------------

Atom: ir::Expr = {
    "ident"                         => ir::expr_var(<>),
    <"ident"> "(" <List<Expr>> ")"  => ir::expr_call(<>),
    <"ident"> "(" "*" ")"           => ir::expr_call_star(<>),
    <t:TScalar> "(" <e:Expr> ")"    => ir::expr_cast(e, &t),
    Value                           => ir::expr_lit(<>),
    "?"                             => ir::expr_param_positional(param_pos),
    "$num"                          => ir::expr_param_numbered(<>),
    "$name"                         => ir::expr_param_named(<>),
    "{" <Members> "}"               => ir::expr_obj(<>),
    "[" <List<Expr>> "]"            => ir::expr_array(<>),
    "(" <Expr> ")"                  => <>,
    "(" <Select> ")"                => ir::expr_subquery(<>),
    "exists" "(" <Select> ")"       => ir::expr_exists(<>),
};

Expr: ir::Expr = {
    #[precedence(level="0")]
    Atom                        => <>,

    #[precedence(level="1")]    #[assoc(side="left")]
    <Expr> "[" <Expr> "]"                               => ir::expr_jpe(<>),
    <base:Expr> "[" <first:Expr> "," <rest:List<Expr>> "]" => ir::expr_subscript(base, first, rest),
    <Expr> "." <"ident">                                => ir::expr_jpk(<>),

    #[precedence(level="2")]    #[assoc(side="left")]
    <Expr> "*" <Expr>           => ir::expr_binary("*", <>),
    <Expr> "/" <Expr>           => ir::expr_binary("/", <>),
    <Expr> "%" <Expr>           => ir::expr_binary("%", <>),

    #[precedence(level="3")]    #[assoc(side="left")]
    <Expr> "+" <Expr>           => ir::expr_binary("+", <>),
    <Expr> "-" <Expr>           => ir::expr_binary("-", <>),

    #[precedence(level="4")]    #[assoc(side="left")]
    <Expr> "<" <Expr>           => ir::expr_binary("<", <>),
    <Expr> "<=" <Expr>          => ir::expr_binary("<=", <>),
    <Expr> "=" <Expr>           => ir::expr_binary("=", <>),
    <Expr> ">" <Expr>           => ir::expr_binary(">", <>),
    <Expr> ">=" <Expr>          => ir::expr_binary(">=", <>),
    <Expr> "!=" <Expr>          => ir::expr_binary("!=", <>),
    // Quantified comparisons `lhs <op> any/all (select ...)`. The `any`/`all`
    // tail can't begin an ordinary expression, so LR(1) picks these apart from
    // the binary rules above by a single lookahead token after the operator.
    <l:Expr> "<"  <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Lt, r.0, r.1),
    <l:Expr> "<=" <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Le, r.0, r.1),
    <l:Expr> "="  <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Eq, r.0, r.1),
    <l:Expr> ">"  <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Gt, r.0, r.1),
    <l:Expr> ">=" <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Ge, r.0, r.1),
    <l:Expr> "!=" <r:QuantRhs>  => ir::expr_quantify(l, ir::CmpOp::Ne, r.0, r.1),

    #[precedence(level="5")]                    #[assoc(side="left")]
    <Expr> "is" "null"                          => ir::expr_is_null(<>),
    <Expr> "is" "not" "null"                    => ir::expr_is_not_null(<>),
    <Expr> "is" "true"                          => ir::expr_is_true(<>),
    <Expr> "is" "false"                         => ir::expr_is_false(<>),
    <Expr> "is" "unknown"                       => ir::expr_is_unknown(<>),
    <Expr> "is" "not" "true"                    => ir::expr_is_not_true(<>),
    <Expr> "is" "not" "false"                   => ir::expr_is_not_false(<>),
    <Expr> "is" "not" "unknown"                 => ir::expr_is_not_unknown(<>),
    <Expr> "between" <Expr> "and" <Expr>        => ir::expr_between(<>),
    <Expr> "not" "between" <Expr> "and" <Expr>  => ir::expr_not_between(<>),
    <Expr> "in" "(" <List<Expr>> ")"            => ir::expr_in_list(<>),
    <Expr> "not" "in" "(" <List<Expr>> ")"      => ir::expr_not_in_list(<>),
    <Expr> "in" "(" <Select> ")"                => ir::expr_in_subquery(<>),
    <Expr> "not" "in" "(" <Select> ")"          => ir::expr_not_in_subquery(<>),

    #[precedence(level="6")]
    "not" <Expr>                => ir::expr_not(<>),

    #[precedence(level="7")]    #[assoc(side="left")]
    <Expr> "and" <Expr>         => ir::expr_binary("and", <>),

    #[precedence(level="8")]    #[assoc(side="left")]
    <Expr> "or" <Expr>          => ir::expr_binary("or", <>),
}

// The right-hand side of a quantified comparison: the quantifier (`any` reuses
// the `t_any` type token; `all` returns `true`) and the subquery it ranges over.
QuantRhs: (bool, ir::Select) = {
    "t_any" "(" <Select> ")"    => (false, <>),
    "all"   "(" <Select> ")"    => (true, <>),
};

Value: Value = {
    "null"      => Value::null(),
    "true"      => Value::bool(true),
    "false"     => Value::bool(false),
    <n:"number"> => Value::number(&n),
    "string"    => Value::string(<>),
};

//=== Objects

Members: Vec<ir::Member> = List<Member>;

// Object keys are quoted strings only; a bare identifier key is a syntax error.
Member: ir::Member = {
    <"string"> ":" <Expr>   => ir::member_assign(<>),
    "..." <Expr>            => ir::member_spread(<>),
}

//------------------------------
// MACROS
//------------------------------

List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
