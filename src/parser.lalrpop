use std::str::FromStr;
use lalrpop_util::ParseError;
use crate::error::Error;
use crate::compiler::Compiler;
use crate::ir;

grammar;

// goals
//  select *
//  select col1, col2, ...
//  delete from <tbl>
//  insert into <tbl> values '...'

extern {
    type Error = Error;
}

pub Rql = <Statement> ";";

Statement: ir::Statement = {
    Select => ir::Statement::Select(<>),
    Insert => ir::Statement::Insert(<>),
    Delete => ir::Statement::Delete(<>),
};

Select: ir::Select = "SELECT" <sel:SelectList> <inp:From> => { 
    ir::Select { 
        sel,
        inp,
    }
};

SelectList: Vec<ir::Member> = List<SelectMember>;

SelectMember: ir::Member = {
    <col:Name> => {
        ir::Member {
            rex: ir::Rex::Col(col.clone()),
            var: col.clone(),
        }
    },
    <col:Name> "AS" <var:Name> => {
        ir::Member {
            rex: ir::Rex::Col(col),
            var,
        }
    },
}

From: ir::From = {
    "FROM" <tbl:Name> => {
        let tbl = tbl;
        let var = tbl.clone();
        ir::From { tbl, var }
    },
    "FROM" <tbl:Name> "AS" <var:Name> => {
        ir::From { tbl, var }
    },
}

// TODO
Insert: () = "INSERT" "INTO" <table:Name> "VALUES" => {
    println!("parse insert");
};

// TODO
Delete: () = "DELETE" "FROM" <table:Name> => {
    println!("parse delete");
};

Alias: String = "AS" <Name>;

//------------------------------
// TOKENS
//------------------------------

Name: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => String::from_str(<>).unwrap();

//------------------------------
// MACROS
//------------------------------

// List of comma separated elements T.
List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
