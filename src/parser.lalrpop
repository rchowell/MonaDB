use std::str::FromStr;
use lalrpop_util::ParseError;
use crate::error::Error;
use crate::compiler::Compiler;
use crate::ir;

grammar;

// goals
//  xx select var1, var2, ...
//  xx select *
//  xx drop table <tbl>
//  xx delete from <tbl>
//  insert into <tbl> values '...'

extern {
    type Error = Error;
}

pub Rql = <Statement> ";";

Statement: ir::Statement = {
    Select  => ir::Statement::Select(<>),
    Insert  => ir::Statement::Insert(<>),
    Delete  => ir::Statement::Delete(<>),
    Drop    => ir::Statement::Drop(<>),
};

Select: ir::Select = {
    "SELECT" "*"              <inp:From>    => ir::select_star(inp),
    "SELECT" <sel:SelectList> <inp:From>    => ir::select_list(inp, sel),
};

SelectList: Vec<ir::Member> = List<SelectItem>;

SelectItem: ir::Member = {
    <var:Name> => {
        let key = var.clone();
        let val = ir::expr_var(var);
        ir::member(key, val)
    },
    <val:Expr> "AS" <key:Name> => ir::member(key, val),
}

From: ir::From = {
    "FROM" <tbl:Name> => {
        let tbl = tbl;
        let var = tbl.clone();
        ir::From { tbl, var }
    },
    "FROM" <tbl:Name> "AS" <var:Name> => {
        ir::From { tbl, var }
    },
}

// TODO
Insert: () = "INSERT" "INTO" <table:Name> "VALUES" => {
    println!("parse insert");
};

// KISS
Delete: String = "DELETE" "FROM" <Name>;

// KISS
Drop: String = "DROP" "TABLE" <Name>;
 
Alias: String = "AS" <Name>;

//------------------------------
// EXPRESSIONS
//------------------------------

Expr: ir::Expr = {
    <var:Name>                      => ir::expr_var(var),
    <inp:Expr> "[" <idx:Num> "]"    => ir::expr_jpi(inp, idx),
    "(" <inp:Expr> ")"              => inp,
};

//------------------------------
// TOKENS
//------------------------------

Name: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => String::from_str(<>).unwrap();
Num: usize = r"[0-9]+" => usize::from_str(<>).unwrap();

//------------------------------
// MACROS
//------------------------------

// List of comma separated elements T.
List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
