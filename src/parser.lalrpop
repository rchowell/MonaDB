use std::str::FromStr;
use lalrpop_util::ParseError;
use crate::error::Error;
use crate::compiler::Compiler;
use crate::ir;

grammar;

extern {
    type Error = Error;
}

pub Rql = <Statement> ";";

Statement: ir::Statement = {
    Create  => ir::Statement::Create(<>),
    Delete  => ir::Statement::Delete(<>),
    Drop    => ir::Statement::Drop(<>),
    Insert  => ir::Statement::Insert(<>),
    Select  => ir::Statement::Select(<>),
};

Create: ir::Create = {
    "create" "table" <Name> "(" <TableMembers> ")" => ir::create_table(<>)
};

TableMembers: Vec<ir::TableMember> = List<TableMember>;

TableMember: ir::TableMember = <Name> <Type> => ir::table_member(<>);

Select: ir::Select = {
    "select" "*"          <From>    => ir::select_star(<>),
    "select" <SelectList> <From>    => ir::select_list(<>),
};

SelectList: Vec<ir::Member> = List<SelectItem>;

SelectItem: ir::Member = {
    <Expr>              => ir::select_item_no_alias(<>),
    <Expr> "as" <Name>  => ir::select_item(<>),
}

From: ir::From = {
    "from" <Name>               => ir::from_no_alias(<>),
    "from" <Name> "as" <Name>   => ir::from(<>)
}

Insert: ir::Insert = {
    "insert" "into" <InsertTarget> <InsertSource> => ir::insert(<>),
}

InsertTarget: String = Name;

InsertSource: Vec<ir::Obj> = {
    InsertValue     => vec![<>],
    InsertValues    => <>,
};

InsertValue: ir::Obj = {
    "{" <Members> "}" => <>,
};

InsertValues: Vec<ir::Obj> = {
    "[" <InsertValuesList> "]" => <>,
};

InsertValuesList: Vec<ir::Obj> = List<InsertValue>;

// KISS
Delete: String = "delete" "from" <Name>;

// KISS
Drop: String = "drop" "table" <Name>;

//------------------------------
// TYPES
//------------------------------

Type: ir::Type = {
    "bool"      => ir::Type::Bool,
    "number"    => ir::Type::Number,
    "string"    => ir::Type::String,
    "object"    => ir::Type::Object,
    "array"     => ir::Type::Array,
    "any"       => ir::Type::Any,
};

//------------------------------
// EXPRESSIONS
//------------------------------

Expr: ir::Expr = {
    Name                    => ir::expr_var(<>),
    Number                  => ir::expr_number(<>), 
    <Expr> "[" <Number> "]" => ir::expr_jpi(<>),
    <Expr> "." <Name>       => ir::expr_jpk(<>),
    "{" <Members> "}"       => ir::expr_obj(<>),
    "(" <Expr> ")"          => <>,
};

Members: Vec<ir::Member> = List<Member>;

Member: ir::Member = <Name> ":" <Expr> => ir::member(<>);

//------------------------------
// TOKENS
//------------------------------

Name: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => String::from_str(<>).unwrap();
Number: usize = r"[0-9]+" => usize::from_str(<>).unwrap();

//------------------------------
// MACROS
//------------------------------

// List of comma separated elements T.
List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
